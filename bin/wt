#!/usr/bin/env bash
# wt — a fixed pool of reusable worktrees ("slots") for parallel agent sessions
#
# Each configured repo gets numbered slots next to it: linked worktrees that a
# session claims, works in, and releases. Warm slots are kept with their build
# output so the next session builds incrementally; burst slots (above the warm
# count, up to the max) are deleted on release, so disk stays bounded.
#
# Usage:
#   wt claim [REPO] [--session ID]   claim a slot (reuses this session's) and print its path
#   wt release [--session ID]        release this session's slots (burst slots are deleted)
#   wt status                        list slots, who holds them and whether they're clean
#   wt path [--session ID]           print this session's slot paths
#   wt remove SLOT [--force]         delete a slot's worktree now
#   wt gc [--if-due] [--dry-run]     expire idle leases, delete free burst slots
#
# The session ID comes from --session or $WT_SESSION (the Claude Code hook sets it).
#
# Config: ~/.config/wt/config (bash, machine-local, never in this repo). Without
# it every command is a no-op, so this is safe on any machine:
#   wt_repo ~/code/app warm=2 max=4 [base=origin/main] [name=app] [root=DIR]
#   WT_ROOT=~/worktrees          # where slots live unless root= says otherwise
#   WT_IDLE_HOURS=72             # a lease with no activity this long is released
# Optional functions in the config run at these points, with the slot path as $1:
#   wt_after_create, wt_after_claim, wt_after_release, wt_before_remove,
#   wt_after_remove (no args), wt_gc_extra (no args), wt_context_extra (no args;
#   prints extra notes for the agent).
# Must stay bash 3.2 compatible (macOS /bin/bash).

WT_CONFIG="${WT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/wt/config}"
WT_STATE="${WT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/wt}"
WT_ROOT="$HOME/worktrees"
WT_IDLE_HOURS=72
WT_GC_HOURS=24
WT_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

R_PATH=() R_NAME=() R_WARM=() R_MAX=() R_BASE=() R_ROOT=()

# Called from the config file, once per repo
wt_repo() {
    local path="${1/#\~/$HOME}" name="" warm=2 max=4 base="" root="" arg
    shift
    for arg in "$@"; do
        case "$arg" in
            warm=*) warm="${arg#warm=}" ;;
            max=*) max="${arg#max=}" ;;
            base=*) base="${arg#base=}" ;;
            name=*) name="${arg#name=}" ;;
            root=*) root="${arg#root=}" ;;
            *) echo "wt: unknown option '$arg' for $path" >&2 ;;
        esac
    done
    [ "$max" -lt "$warm" ] && max="$warm"
    R_PATH+=("${path%/}")
    R_NAME+=("${name:-$(basename "$path")}")
    R_WARM+=("$warm")
    R_MAX+=("$max")
    R_BASE+=("$base")
    R_ROOT+=("${root/#\~/$HOME}")
}

# shellcheck source=/dev/null
[ -f "$WT_CONFIG" ] && source "$WT_CONFIG"
WT_ROOT="${WT_ROOT/#\~/$HOME}"
LEASES="$WT_STATE/leases"

###############################################################################
# Helpers
###############################################################################

die() { echo "wt: $*" >&2; exit 1; }
note() { echo "wt: $*" >&2; }
has_hook() { declare -F "$1" > /dev/null; }
run_hook() { has_hook "$1" && "$@" >&2; return 0; } # stdout is reserved for paths

mtime() { stat -c %Y "$1" 2> /dev/null || stat -f %m "$1" 2> /dev/null || echo 0; }
now() { date +%s; }

repo_index() { # name or path -> index into R_*
    local i want="${1%/}"
    want="${want/#\~/$HOME}"
    for i in "${!R_NAME[@]}"; do
        if [ "${R_NAME[$i]}" = "$want" ] || [ "${R_PATH[$i]}" = "$want" ]; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

vcs_of() { # main checkout -> git | sl
    if [ -e "$1/.git" ]; then echo git; elif [ -d "$1/.sl" ] || [ -d "$1/.hg" ]; then echo sl; fi
}

slot_id() { echo "${R_NAME[$1]}-$2"; }
slot_root() { echo "${R_ROOT[$1]:-$WT_ROOT}"; }
slot_path() { echo "$(slot_root "$1")/$(slot_id "$1" "$2")"; }

lease_holder() { cat "$LEASES/$1/session" 2> /dev/null; }

lease_idle_hours() { echo $((($(now) - $(mtime "$LEASES/$1/session")) / 3600)); }

lease_expired() { [ "$(lease_idle_hours "$1")" -ge "$WT_IDLE_HOURS" ]; }

# Prints why a slot can't be reused or deleted, or nothing if it's clean.
# Uncommitted or untracked files count; in git, so do commits no ref reaches
# (made on a detached HEAD), since removing the worktree would orphan them.
# sl keeps every commit in the shared store, so only the working copy matters.
slot_dirty() {
    local path="$1" vcs="$2" out
    [ -d "$path" ] || return 0
    if [ "$vcs" = git ]; then
        out=$(git -C "$path" status --porcelain 2> /dev/null | head -3)
        [ -n "$out" ] && { echo "uncommitted changes"; return; }
        [ -z "$(git -C "$path" for-each-ref --contains HEAD --count=1 2> /dev/null)" ] \
            && echo "commits not on any branch"
    else
        out=$(cd "$path" && sl status 2> /dev/null | head -3)
        [ -n "$out" ] && echo "uncommitted changes"
    fi
}

# The revision new work starts from: base= if set, else origin/HEAD or the
# main checkout's commit. A git remote branch is fetched first so it's current;
# sl isn't pulled, since big repos pull slowly and usually pull in the background.
slot_base() {
    local main="${R_PATH[$1]}" vcs="$2" base="${R_BASE[$1]}"
    if [ "$vcs" = git ]; then
        if [ -z "$base" ] && git -C "$main" rev-parse -q --verify origin/HEAD > /dev/null; then
            base=$(git -C "$main" rev-parse --abbrev-ref origin/HEAD)
        fi
        if [ -n "$base" ] && git -C "$main" remote | grep -qxF "${base%%/*}"; then
            git -C "$main" fetch -q "${base%%/*}" "${base#*/}" > /dev/null 2>&1 \
                || note "couldn't fetch $base; using the last fetched copy"
        fi
        echo "${base:-$(git -C "$main" rev-parse HEAD)}"
    else
        echo "${base:-$(cd "$main" && sl whereami)}"
    fi
}

create_slot() {
    local i="$1" n="$2" main="${R_PATH[$1]}" vcs path base
    vcs=$(vcs_of "$main")
    path=$(slot_path "$i" "$n")
    base=$(slot_base "$i" "$vcs")
    mkdir -p "$(slot_root "$i")"
    note "creating $(slot_id "$i" "$n") at $path (first build there will be cold)..."
    if [ "$vcs" = git ]; then
        git -C "$main" worktree add -q --detach "$path" "$base" >&2 || return 1
    else
        (cd "$main" && sl worktree add "$path" -r "$base" --label "wt $(slot_id "$i" "$n")") >&2 || return 1
    fi
    run_hook wt_after_create "$path"
}

# Moves a clean slot to the base revision so new work starts from it.
# Existing commits stay reachable (sl: shared store; git: slot_dirty checked).
refresh_slot() {
    local i="$1" path="$2" vcs="$3" base
    base=$(slot_base "$i" "$vcs")
    if [ "$vcs" = git ]; then
        git -C "$path" switch -q --detach "$base" 2> /dev/null
    else
        (cd "$path" && sl goto -q "$base" > /dev/null 2>&1)
    fi || note "couldn't move $(basename "$path") to $base; it stays where it was"
}

# Removes the linked worktree for slot N of repo I and its leftovers
remove_slot() {
    local i="$1" n="$2" force="${3:-}" main="${R_PATH[$1]}" vcs path id why plist dir
    vcs=$(vcs_of "$main")
    path=$(slot_path "$i" "$n")
    id=$(slot_id "$i" "$n")
    if [ -z "$force" ]; then
        why=$(slot_dirty "$path" "$vcs")
        [ -n "$why" ] && { note "keeping $id: $why"; return 1; }
    fi
    run_hook wt_before_remove "$path"
    # Xcode keys DerivedData by workspace path, so a deleted slot's would never be reused
    if [ "$(uname)" = Darwin ]; then
        for plist in "$HOME"/Library/Developer/Xcode/DerivedData/*/info.plist; do
            [ -f "$plist" ] || continue
            dir=$(/usr/libexec/PlistBuddy -c 'Print :WorkspacePath' "$plist" 2> /dev/null)
            case "$dir" in "$path"/*) rm -rf "$(dirname "$plist")" ;; esac
        done
    fi
    if [ -d "$path" ]; then
        if [ "$vcs" = git ]; then
            git -C "$main" worktree remove ${force:+--force} "$path" >&2 || return 1
        else
            (cd "$main" && sl worktree remove -y ${force:+--force} "$path") >&2 || return 1
        fi
    fi
    rm -rf "${LEASES:?}/$id"
    run_hook wt_after_remove
    note "removed $id"
}

session_arg() { # --session ID or $WT_SESSION
    [ -n "${SESSION:-}" ] && { echo "$SESSION"; return; }
    [ -n "${WT_SESSION:-}" ] && { echo "$WT_SESSION"; return; }
    die "no session ID; pass --session ID or set WT_SESSION"
}

# Calls FN i n for every slot of every repo, including leftovers past max
each_slot() {
    local fn="$1" i n top dir
    for i in "${!R_NAME[@]}"; do
        top="${R_MAX[$i]}"
        for dir in "$(slot_root "$i")/${R_NAME[$i]}"-*; do
            n="${dir##*-}"
            case "$n" in '' | *[!0-9]*) continue ;; esac
            [ "$n" -gt "$top" ] && top="$n"
        done
        n=1
        while [ "$n" -le "$top" ]; do
            "$fn" "$i" "$n"
            n=$((n + 1))
        done
    done
}

###############################################################################
# Commands
###############################################################################

cmd_claim() {
    local session repo="${1:-}" i n id path vcs why
    session=$(session_arg) || exit 1
    if [ -n "$repo" ]; then
        i=$(repo_index "$repo") || die "'$repo' isn't configured in $WT_CONFIG"
    elif [ "${#R_NAME[@]}" -eq 1 ]; then
        i=0
    elif [ "${#R_NAME[@]}" -eq 0 ]; then
        die "no repos configured in $WT_CONFIG"
    else
        die "pick a repo: ${R_NAME[*]}"
    fi
    vcs=$(vcs_of "${R_PATH[$i]}")
    [ -n "$vcs" ] || die "${R_PATH[$i]} isn't a git or sl checkout"
    mkdir -p "$LEASES"

    # Already holding one for this repo: keep using it
    n=1
    while [ "$n" -le "${R_MAX[$i]}" ]; do
        id=$(slot_id "$i" "$n")
        if [ "$(lease_holder "$id")" = "$session" ] && [ -d "$(slot_path "$i" "$n")" ]; then
            touch "$LEASES/$id/session"
            slot_path "$i" "$n"
            return 0
        fi
        n=$((n + 1))
    done

    # Lowest free slot; warm ones come first, so bursts only exist under load
    n=1
    while [ "$n" -le "${R_MAX[$i]}" ]; do
        id=$(slot_id "$i" "$n")
        path=$(slot_path "$i" "$n")
        if [ -d "$LEASES/$id" ] && lease_expired "$id" && [ -z "$(slot_dirty "$path" "$vcs")" ]; then
            note "taking over $id (idle $(lease_idle_hours "$id")h)"
            rm -rf "${LEASES:?}/$id"
        fi
        if mkdir "$LEASES/$id" 2> /dev/null; then # atomic: two sessions can't both get it
            echo "$session" > "$LEASES/$id/session"
            if [ -d "$path" ]; then
                why=$(slot_dirty "$path" "$vcs")
                if [ -n "$why" ]; then
                    note "skipping $id: left with $why (see: wt status)"
                    rm -rf "${LEASES:?}/$id"
                    n=$((n + 1))
                    continue
                fi
                refresh_slot "$i" "$path" "$vcs"
            elif ! create_slot "$i" "$n"; then
                rm -rf "${LEASES:?}/$id"
                die "couldn't create $id"
            fi
            [ "$n" -gt "${R_WARM[$i]}" ] && note "$id is a burst slot; it's deleted on release"
            run_hook wt_after_claim "$path"
            echo "$path"
            return 0
        fi
        n=$((n + 1))
    done
    cmd_status >&2
    die "all ${R_MAX[$i]} ${R_NAME[$i]} slots are in use; release one or raise max= in $WT_CONFIG"
}

release_one() {
    local i="$1" n="$2" id path
    id=$(slot_id "$i" "$n")
    [ "$(lease_holder "$id")" = "$SESSION_ID" ] || return 0
    path=$(slot_path "$i" "$n")
    rm -rf "${LEASES:?}/$id"
    run_hook wt_after_release "$path"
    if [ "$n" -gt "${R_WARM[$i]}" ]; then
        remove_slot "$i" "$n" || note "$id stays until it's clean; wt gc will delete it then"
    else
        note "released $id"
    fi
}

cmd_release() {
    SESSION_ID=$(session_arg) || exit 1
    each_slot release_one
}

path_one() {
    [ "$(lease_holder "$(slot_id "$1" "$2")")" = "$SESSION_ID" ] && slot_path "$1" "$2"
    return 0
}

cmd_path() {
    SESSION_ID=$(session_arg) || exit 1
    each_slot path_one
}

touch_one() {
    local id
    id=$(slot_id "$1" "$2")
    [ "$(lease_holder "$id")" = "$SESSION_ID" ] && touch "$LEASES/$id/session"
    return 0
}

cmd_touch() {
    SESSION_ID=$(session_arg) || exit 1
    each_slot touch_one
}

status_one() {
    local i="$1" n="$2" id path kind holder state
    id=$(slot_id "$i" "$n")
    path=$(slot_path "$i" "$n")
    [ -d "$path" ] || [ -d "$LEASES/$id" ] || return 0
    kind=warm
    [ "$n" -gt "${R_WARM[$i]}" ] && kind=burst
    holder=$(lease_holder "$id")
    if [ -n "$holder" ]; then
        holder="${holder:0:8} ($(lease_idle_hours "$id")h idle)"
    else
        holder=free
    fi
    state=$(slot_dirty "$path" "$(vcs_of "${R_PATH[$i]}")")
    printf '%-16s %-6s %-22s %s\n' "$id" "$kind" "$holder" "${state:-clean}"
}

cmd_status() {
    [ "${#R_NAME[@]}" -gt 0 ] || { echo "No repos configured in $WT_CONFIG"; return; }
    local i
    for i in "${!R_NAME[@]}"; do
        echo "${R_NAME[$i]}: ${R_PATH[$i]}, ${R_WARM[$i]} warm, up to ${R_MAX[$i]} (slots in $(slot_root "$i"))"
    done
    printf '%-16s %-6s %-22s %s\n' SLOT KIND SESSION STATE
    each_slot status_one
}

cmd_remove() {
    local target="${1:-}" force="${2:-}" i n
    [ -n "$target" ] || die "usage: wt remove SLOT [--force]"
    target=$(basename "$target")
    n="${target##*-}"
    i=$(repo_index "${target%-*}") || die "no slot named $target"
    if [ -z "$force" ] && [ -n "$(lease_holder "$target")" ]; then
        die "$target is claimed by session $(lease_holder "$target"); release it first or pass --force"
    fi
    remove_slot "$i" "$n" "$force"
}

gc_one() {
    local i="$1" n="$2" id path why
    id=$(slot_id "$i" "$n")
    path=$(slot_path "$i" "$n")
    if [ -d "$LEASES/$id" ] && lease_expired "$id"; then
        echo "lease on $id expired ($(lease_idle_hours "$id")h idle)"
        [ -n "$DRY_RUN" ] || { rm -rf "${LEASES:?}/$id"; run_hook wt_after_release "$path"; }
    fi
    [ -d "$path" ] && [ ! -d "$LEASES/$id" ] || return 0
    if [ "$n" -gt "${R_WARM[$i]}" ]; then
        why=$(slot_dirty "$path" "$(vcs_of "${R_PATH[$i]}")")
        if [ -n "$why" ]; then
            echo "keeping free burst slot $id: $why"
        elif [ -n "$DRY_RUN" ]; then
            echo "would remove free burst slot $id"
        else
            remove_slot "$i" "$n"
        fi
    fi
}

cmd_gc() {
    local if_due="" stamp="$WT_STATE/last-gc" i
    DRY_RUN=""
    for arg in "$@"; do
        case "$arg" in
            --if-due) if_due=1 ;;
            --dry-run) DRY_RUN=1 ;;
        esac
    done
    [ "${#R_NAME[@]}" -gt 0 ] || return 0
    if [ -n "$if_due" ] && [ -f "$stamp" ] \
        && [ $(($(now) - $(mtime "$stamp"))) -lt $((WT_GC_HOURS * 3600)) ]; then
        return 0
    fi
    mkdir -p "$WT_STATE"
    [ -n "$DRY_RUN" ] || touch "$stamp"
    echo "== wt gc $(date '+%Y-%m-%d %H:%M') =="
    each_slot gc_one
    if [ -z "$DRY_RUN" ]; then
        for i in "${!R_PATH[@]}"; do
            [ "$(vcs_of "${R_PATH[$i]}")" = git ] && git -C "${R_PATH[$i]}" worktree prune
        done
        run_hook wt_gc_extra
    fi
}

# Instructions for the agent, printed by the Claude Code SessionStart hook
cmd_context() {
    [ "${#R_NAME[@]}" -gt 0 ] || return 0
    local session held i list=""
    session=$(session_arg) || exit 1
    SESSION_ID="$session"
    held=$(each_slot path_one)
    for i in "${!R_NAME[@]}"; do
        list="${list}${list:+, }${R_NAME[$i]} (${R_PATH[$i]})"
    done
    echo "# Worktree slots"
    echo "Parallel agent sessions on this machine work in worktree slots: reusable linked checkouts of $list."
    if [ -n "$held" ]; then
        echo "This session holds these slots; do all work for those repos there, never in the main checkout:"
        echo "- ${held//$'\n'/$'\n'- }"
    fi
    echo "Before you edit files, build or commit in one of those repos, claim a slot and work only in the path it prints:"
    echo "    $WT_BIN claim <repo> --session $session"
    echo "It returns the slot you already hold, so rerun it whenever you've lost track of yours."
    echo "Reading code in the main checkout is fine; never edit or build there, since other sessions and the user share it."
    echo "When the task is finished and everything is committed, run: $WT_BIN release --session $session"
    echo "A slot left with uncommitted files can't be reused or cleaned up. See all slots with '$WT_BIN status'."
    has_hook wt_context_extra && wt_context_extra
    return 0
}

###############################################################################
# Main
###############################################################################

SESSION="" FORCE="" ARGS=()
cmd="${1:-help}"
[ $# -gt 0 ] && shift
while [ $# -gt 0 ]; do
    case "$1" in
        --session) SESSION="${2:-}"; shift ;;
        --session=*) SESSION="${1#--session=}" ;;
        --force) FORCE=1 ;;
        *) ARGS+=("$1") ;;
    esac
    shift
done
set -- ${ARGS[@]+"${ARGS[@]}"}

case "$cmd" in
    claim) cmd_claim "$@" ;;
    release) cmd_release ;;
    status) cmd_status ;;
    path) cmd_path ;;
    touch) [ "${#R_NAME[@]}" -gt 0 ] && cmd_touch; exit 0 ;;
    remove) cmd_remove "${1:-}" "$FORCE" ;;
    gc) cmd_gc "$@" ;;
    context) cmd_context ;;
    configured) [ "${#R_NAME[@]}" -gt 0 ] ;;
    help | -h | --help) sed -n '2,/^# Must stay/p' "$WT_BIN" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (see: wt help)" ;;
esac
